#include <windows.h>

#define IDM_MENU            100
#define IDM_OPEN_FOLDER     101
#define IDM_BACKUP_PROFILES 102
#define IDM_EXIT            103
#define IDM_ABOUT           104

1 ICON "unnamed.ico"
1 24 "undawn_reroll.manifest"

IDM_MENU MENU
BEGIN
    POPUP "&Outils"
    BEGIN
        MENUITEM "&Ouvrir le dossier des profils", IDM_OPEN_FOLDER
        MENUITEM "&Sauvegarder tous les profils...", IDM_BACKUP_PROFILES
        MENUITEM SEPARATOR
        MENUITEM "&Quitter", IDM_EXIT
    END
    POPUP "&À propos"
    BEGIN
        MENUITEM "Made by Th0r", IDM_ABOUT
    END
END
